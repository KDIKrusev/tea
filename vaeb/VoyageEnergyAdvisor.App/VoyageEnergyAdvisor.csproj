<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <UserSecretsId>7e3df7c3-ab15-4a0f-b239-3f5dfbc79254</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoyageEnergyAdvisor.Core\VoyageEnergyAdvisor.Core.csproj" />
    <ProjectReference Include="..\VoyageEnergyAdvisor.Data\VoyageEnergyAdvisor.Data.csproj" />
    <ProjectReference Include="..\VoyageEnergyAdvisor.WebApi\VoyageEnergyAdvisor.WebApi.csproj" />
  </ItemGroup>

	<ItemGroup>
		<None Update="VoyageEnergyAdvisor.Core\Configuration\DefaultResources\WeatherForecastService.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="VoyageEnergyAdvisor.Core\Configuration\DefaultResources\OfflineWeatherForecast.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
