{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "C:/Vec/Logs/Vec-logs.txt",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 1000000000,
          "retainedFileCountLimit": 10,
          "restrictedToMinimumLevel": "Information"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=VoyageEnergyDB;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True"
  },
  "AllowedCorsOrigins": [
    "http://localhost:4200"
  ]
}
